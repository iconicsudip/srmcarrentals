# ---- Database (Neon PostgreSQL) ----
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@YOUR_HOST-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DIRECT_DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@YOUR_HOST.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DATABASE_URL_POOLED="postgresql://neondb_owner:YOUR_PASSWORD@YOUR_HOST-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ---- Auth ----
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars-long"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars-long"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
# Minutes a "Temporary Hold" booking stays valid before auto-release
BOOKING_HOLD_MINUTES=15

# ---- App URLs ----
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000/api/v1"

# ---- Maps provider (abstraction in lib/map) ----
MAP_PROVIDER="google"
GOOGLE_MAPS_API_KEY=""

# ---- Payments ----
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""

CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
CASHFREE_WEBHOOK_SECRET=""

# ---- Email (settings can also be overridden from admin > Email Settings) ----
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="no-reply@srmcarrentals.com"

# ---- SMS / WhatsApp (provider-agnostic; configure real provider in admin) ----
SMS_PROVIDER_API_KEY=""
WHATSAPP_PROVIDER_API_KEY=""

# ---- Admin Dashboard Login Credentials ----
ADMIN_EMAIL="admin@srmcarrentals.com"
ADMIN_PASSWORD="AdminPassword123!"
SEED_SUPER_ADMIN_EMAIL="admin@srmcarrentals.com"
SEED_SUPER_ADMIN_PASSWORD="AdminPassword123!"

# ---- File storage & AWS S3 ----
STORAGE_PROVIDER="s3"
UPLOADS_DIR="./public/uploads"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET="srm-rentals-uploads"
AWS_REGION="ap-south-1"

# ---- Google Reviews (via RapidAPI) ----
RAPIDAPI_REVIEWS_KEY=""
RAPIDAPI_REVIEWS_HOST="google-map-reviews.p.rapidapi.com"
RAPIDAPI_REVIEWS_SEARCH_ID=""
